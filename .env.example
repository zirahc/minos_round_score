# Copy to .env and fill in. Do not commit .env.

# Supabase project that holds public.rounds.
SUPABASE_URL=https://aitagsfejkuuevcagniz.supabase.co

# Service role key. Row level security is enabled on public.rounds.
# SUPABASE_KEY is accepted as an alias.
SUPABASE_SERVICE_ROLE_KEY=

# Only required when the Hugging Face model repo is private.
HF_TOKEN=

# Optional. Defaults to the minos_subnet checkout next to this folder.
# MINOS_SUBNET=C:\Project\TAO\minos_subnet
